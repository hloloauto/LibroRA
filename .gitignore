# =============================================================================
#  LibroRA - Libro AR Infantil (Unity URP + AR Foundation + ARCore, Android)
#  .gitignore optimizado para Unity en Android
#  Base: github/gitignore Unity.gitignore (CC0-1.0) + reglas Android / IDE / SO
#
#  IMPORTANTE: los archivos .meta de Assets/ y ProjectSettings/ DEBEN versionarse.
#  Este archivo no los ignora en ningun caso (ver bloque final de excepciones).
# =============================================================================

# -----------------------------------------------------------------------------
# Carpetas temporales y pesadas generadas por Unity
# -----------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
.utmp/
*.log

# Escenas autogeneradas por el Test Runner / play mode tests
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Cache autogenerada dentro de Assets
/[Aa]ssets/[Ss]ceneDependencyCache*

# Plugin autogenerado de JetBrains Rider
/[Aa]ssets/Plugins/Editor/JetBrains*

# Descomenta si usas Asset Store Tools y no quieres versionarlas
# /[Aa]ssets/AssetStoreTools*

# -----------------------------------------------------------------------------
# Soluciones y proyectos generados (Unity los regenera automaticamente)
# -----------------------------------------------------------------------------
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# .meta de simbolos de depuracion generados (no son assets reales)
*.pidb.meta
*.pdb.meta
*.mdb.meta

# -----------------------------------------------------------------------------
# Artefactos de compilacion Android
# -----------------------------------------------------------------------------
*.apk
*.aab
*.apks
*.obb
*.idsig
*.symbols.zip
*_BackUpThisFolder_ButDontShipItWithYourGame/
*_BurstDebugInformation_DoNotShip/
.gradle/
/[Gg]radle[Pp]roject/
/[Aa]ndroid[Pp]roject/
local.properties

# Keystores de firma: nunca subir al repositorio
*.keystore
*.jks

# Paquetes exportados y otros binarios
*.unitypackage
*.unitypackage.meta
*.app

# Archivos de crash / diagnostico
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# Blender: los backups .blend1 no son necesarios
*.blend1
*.blend1.meta

# -----------------------------------------------------------------------------
# Addressables / Visual Scripting (por si se agregan en el futuro)
# -----------------------------------------------------------------------------
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# -----------------------------------------------------------------------------
# IDEs
# -----------------------------------------------------------------------------
# Visual Studio
.vs/
# JetBrains Rider
.idea/
*.DotSettings.user
# VS Code: se conservan solo los archivos compartidos del equipo
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json

# -----------------------------------------------------------------------------
# Sistema operativo
# -----------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
# Linux
*~
.directory
.Trash-*

# -----------------------------------------------------------------------------
# Excepciones: preservar SIEMPRE la configuracion del proyecto.
# Los .meta de Assets/ se versionan porque ninguna regla anterior los ignora
# (solo los .meta de basura: *.pdb.meta, *.mdb.meta, *.blend1.meta, etc.).
# -----------------------------------------------------------------------------
!/[Pp]roject[Ss]ettings/
!/[Pp]roject[Ss]ettings/**

# -----------------------------------------------------------------------------
# Assets de terceros con licencia (Synty Studios): NO se publican en el repositorio.
# Quien clone el proyecto debe importar los paquetes POLYGON desde su propia licencia.
# -----------------------------------------------------------------------------
/Assets/SyntyStudios/
/Assets/SyntyStudios.meta

# Copias de recuperacion automaticas de Unity
/Assets/_Recovery/
/Assets/_Recovery.meta

# Archivos temporales de Office (bloqueo de documentos abiertos)
~$*

# Material del curso (pauta, rubrica y ejemplo): no se publica
/pauta evaluacion final.pdf
/rubrica evaluacion final.pdf
/Proyecto de investigación - Evaluación Parcial.pdf
